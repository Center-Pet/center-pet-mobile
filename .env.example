# =============================================================================
# Center Pet Mobile (Expo) — variáveis de ambiente
# Copie para .env.development, .env.production ou .env.test conforme o ambiente.
# Valores EXPO_PUBLIC_* são embutidos no bundle em build time (não use segredos).
# =============================================================================

# --- API ---
# EXPO_PUBLIC_API_URL: URL base da API (Render, etc.). Fallback no código: src-mobile/config/api.js
EXPO_PUBLIC_API_URL=https://centerpet-api.onrender.com/api

# --- New Relic Mobile (build nativo / EAS; injetados no app.config.js) ---
# NEW_RELIC_IOS_APP_TOKEN: New Relic → Mobile → iOS app → Application token
NEW_RELIC_IOS_APP_TOKEN=
# NEW_RELIC_ANDROID_APP_TOKEN: New Relic → Mobile → Android app → Application token
NEW_RELIC_ANDROID_APP_TOKEN=
